{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/ui/matrix", "destination": "/index.html" },
    { "source": "/ui/matrix/", "destination": "/index.html" },
    { "source": "/ui/matrix/:path*", "destination": "/:path*" }
  ]
}
